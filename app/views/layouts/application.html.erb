<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title>Job Portal</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen flex flex-col">

    <!-- Navbar -->
    <nav class="bg-white shadow-md">
      <div class="container mx-auto px-4 py-4 flex justify-between items-center">
        <a href="<%= root_path %>" class="text-2xl font-bold text-indigo-600">Job Portal</a>
        <div class="space-x-4">
          <% if user_signed_in? %>
            <span class="text-gray-700 font-medium">Hello, <%= current_user.first_name %></span>
            <%= link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-red-500 hover:text-red-700 font-medium" %>
          <% else %>
            <%= link_to "Login", new_user_session_path, class: "text-indigo-600 hover:text-indigo-800 font-medium" %>
            <%= link_to "Sign Up", new_user_registration_path, class: "ml-2 text-indigo-600 hover:text-indigo-800 font-medium" %>
          <% end %>
        </div>
      </div>
    </nav>

    <!-- Flash messages -->
    <div class="container mx-auto px-4 mt-4">
      <% flash.each do |type, message| %>
        <% color_class = case type.to_sym
          when :notice then "bg-green-100 border-green-400 text-green-700"
          when :alert then "bg-red-100 border-red-400 text-red-700"
          else "bg-blue-100 border-blue-400 text-blue-700"
        end %>

        <div class="<%= color_class %> border px-4 py-3 rounded mb-4 shadow-sm">
          <%= message %>
        </div>
      <% end %>
    </div>

    <!-- Main content -->
    <main class="flex-1 container mx-auto px-4 py-6">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t mt-auto">
      <div class="container mx-auto px-4 py-6 text-center text-gray-500">
        &copy; <%= Time.current.year %> Job Portal. All rights reserved.
      </div>
    </footer>

  </body>
</html>
