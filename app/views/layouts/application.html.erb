<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title>Job Portal</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen flex flex-col">

    <!-- Navbar -->
    <nav class="bg-white shadow-md sticky top-0 z-50">
  <div class="container mx-auto px-4 py-3 flex justify-between items-center">
    
    <!-- Logo -->
    <a href="<%= root_path %>" class="text-3xl font-extrabold text-indigo-600 hover:text-indigo-700 transition-colors">
      JobPortal
    </a>

    <!-- Desktop Menu -->
    <div class="hidden md:flex items-center space-x-4">
      <% if user_signed_in? %>
        <!-- Quick links (Applications, Bookmarks, etc.) -->
        <%= link_to "Applications", applications_path, class: "text-gray-700 hover:text-indigo-600 font-medium" %>
        <%= link_to "Bookmarks", bookmarks_path, class: "text-gray-700 hover:text-indigo-600 font-medium" %>

        <!-- Profile dropdown -->
        <div class="relative group">
        <button class="text-gray-700 font-medium flex items-center space-x-1">
          <span><%= current_user.first_name %></span>
          <svg class="w-4 h-4 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div class="absolute right-0 mt-2 w-48 bg-white border rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
          <%= link_to "Profile", profile_path, class: "block px-4 py-2 text-gray-700 hover:bg-gray-100" %>
          <%= link_to "Edit Profile", profile_edit_path, class: "block px-4 py-2 text-gray-700 hover:bg-gray-100" %>
          <%= link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete }, class: "block px-4 py-2 text-red-500 hover:bg-gray-100" %>
        </div>
      </div>

      <% else %>
        <%= link_to "Login", new_user_session_path, class: "text-indigo-600 hover:text-indigo-800 font-medium" %>
        <%= link_to "Sign Up", new_user_registration_path, class: "ml-2 text-indigo-600 hover:text-indigo-800 font-medium" %>
      <% end %>
    </div>



    <!-- Mobile Menu Button -->
    <div class="md:hidden">
      <button id="mobile-menu-button" class="text-gray-700 hover:text-indigo-600 focus:outline-none">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t">
    <% if user_signed_in? %>
      <% if current_user.job_seeker? %>
        <%= link_to "Jobs", jobs_path, class: "block px-4 py-3 text-gray-700 hover:bg-indigo-50 rounded-lg transition-colors" %>
        <%= link_to "Bookmarks", bookmarks_path, class: "block px-4 py-3 text-gray-700 hover:bg-indigo-50 rounded-lg transition-colors" %>
        <%= link_to "Applications", applications_path, class: "block px-4 py-3 text-gray-700 hover:bg-indigo-50 rounded-lg transition-colors" %>
        <%= link_to "Profile", profile_path, class: "block px-4 py-3 text-gray-700 hover:bg-indigo-50 rounded-lg transition-colors" %>
        <%= link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete }, class: "block px-4 py-3 text-red-500 hover:bg-red-50 rounded-lg transition-colors" %>
      <% end %>
    <% else %>
      <%= link_to "Login", new_user_session_path, class: "block px-4 py-3 text-gray-700 hover:bg-indigo-50 rounded-lg transition-colors" %>
      <%= link_to "Sign Up", new_user_registration_path, class: "block px-4 py-3 text-indigo-600 hover:bg-indigo-700 rounded-lg transition-colors" %>
    <% end %>
  </div>

  <script>
    const btn = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  </script>
</nav>


    <!-- Flash messages -->
    <div class="container mx-auto px-4 mt-4">
      <% flash.each do |type, message| %>
        <% color_class = case type.to_sym
          when :notice then "bg-green-100 border-green-400 text-green-700"
          when :alert then "bg-red-100 border-red-400 text-red-700"
          else "bg-blue-100 border-blue-400 text-blue-700"
        end %>

        <div class="<%= color_class %> border px-4 py-3 rounded mb-4 shadow-sm">
          <%= message %>
        </div>
      <% end %>
    </div>

    <!-- Main content -->
    <main class="flex-1 container mx-auto px-4 py-6">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t mt-auto">
      <div class="container mx-auto px-4 py-6 text-center text-gray-500">
        &copy; <%= Time.current.year %> Job Portal. All rights reserved.
      </div>
    </footer>

    <!-- Mobile Menu Script -->
    <script>
      const btn = document.getElementById('mobile-menu-button');
      const menu = document.getElementById('mobile-menu');
      btn.addEventListener('click', () => {
        menu.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
