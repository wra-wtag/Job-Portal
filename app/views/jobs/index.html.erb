<!-- app/views/jobs/index.html.erb -->
<div class="bg-gray-50">
  <!-- Hero Section -->
  <div class="relative bg-indigo-900">
    <div class="absolute inset-0">
      <img class="w-full h-full object-cover" 
           src="https://images.unsplash.com/photo-1521737711867-e3b97375f902?ixlib=rb-4.0.3&auto=format&fit=crop&w=1950&q=80" 
           alt="Hero background">
      <div class="absolute inset-0 bg-indigo-900/80"></div>
    </div>
    <div class="relative max-w-4xl mx-auto py-24 px-6 text-center">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white">
        Find Your Dream Job
      </h1>
      <p class="mt-6 text-lg text-indigo-100">
        Discover <%= @total_jobs %> opportunities from <%= @companies_hiring %> companies hiring now.
      </p>
    </div>

    <!-- Search Form -->
    <div class="relative max-w-5xl mx-auto -mt-8 px-6 pb-8">
      <%= form_with url: jobs_path, method: :get, local: true do |f| %>
        <div class="bg-white rounded-2xl shadow-xl p-6">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="md:col-span-2">
              <%= f.text_field :search,
                value: params[:search],
                placeholder: "Job title, company, or keywords...",
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
            </div>
            <div>
              <%= f.text_field :location,
                value: params[:location],
                placeholder: "Location",
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
            </div>
            <div>
              <%= f.submit "Search Jobs", 
                class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 px-4 rounded-md shadow focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
            </div>
          </div>

          <!-- Advanced Filters -->
          <details class="mt-4">
            <summary class="cursor-pointer text-sm font-medium text-gray-600 hover:text-gray-800">
              Advanced Filters
            </summary>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-4 pt-4 border-t border-gray-200">
              <%= f.select :employment_type, @employment_types,
                  { prompt: 'Employment Type', selected: params[:employment_type] },
                  { class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" } %>

              <%= f.select :industry, @industries.map { |i| [i, i] },
                  { prompt: 'Industry', selected: params[:industry] },
                  { class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" } %>

              <%= f.number_field :salary_min,
                  value: params[:salary_min],
                  placeholder: "Min Salary",
                  class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>

              <label class="flex items-center space-x-2">
                <%= f.check_box :remote,
                    { class: "rounded border-gray-300 text-indigo-600 shadow-sm focus:ring-indigo-500",
                      checked: params[:remote] == 'true' },
                    'true', '' %>
                <span class="text-sm text-gray-700">Remote Only</span>
              </label>
            </div>
          </details>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Results Section -->
  <div class="max-w-7xl mx-auto px-6 py-12">
    <!-- Filters & Sorting -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-8 space-y-4 md:space-y-0">
      <h2 class="text-xl font-semibold text-gray-900">
        <%= @jobs.total_count %> Jobs Found
      </h2>
      
      <div class="flex items-center space-x-4">
        <%= form_with url: jobs_path, method: :get, local: true, class: "flex items-center space-x-2" do |f| %>
          <%= hidden_field_tag :search, params[:search] %>
          <%= hidden_field_tag :location, params[:location] %>
          <%= hidden_field_tag :employment_type, params[:employment_type] %>
          <%= hidden_field_tag :industry, params[:industry] %>
          <%= hidden_field_tag :salary_min, params[:salary_min] %>
          <%= hidden_field_tag :remote, params[:remote] %>
          
          <label class="text-sm text-gray-600">Sort by:</label>
          <%= f.select :sort,
              [['Newest', 'newest'], ['Oldest', 'oldest'],
               ['Highest Salary', 'salary_high'], ['Lowest Salary', 'salary_low'],
               ['Company Name', 'company']],
              { selected: params[:sort] || 'newest' },
              { class: "rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500",
                onchange: "this.form.submit();" } %>
        <% end %>
        
        <%= link_to jobs_path, class: "text-sm text-indigo-600 hover:text-indigo-900" do %>
          Clear Filters
        <% end %>
      </div>
    </div>

    <!-- Job Listings -->
    <div class="grid gap-6">
      <% @jobs.each do |job| %>
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-md transition">
          <div class="p-6 flex flex-col sm:flex-row sm:justify-between sm:items-start gap-6">
            <!-- Left: Job Info -->
            <div class="flex-1">
              <div class="flex items-center">
                <% if job.company.logo.attached? %>
                  <%= image_tag job.company.logo, class: "h-12 w-12 rounded-lg object-cover mr-4" %>
                <% else %>
                  <div class="h-12 w-12 bg-gray-200 rounded-lg flex items-center justify-center mr-4">
                    <span class="text-sm font-semibold text-gray-600"><%= job.company.name.first.upcase %></span>
                  </div>
                <% end %>
                <div>
                  <h3 class="text-lg font-semibold text-gray-900">
                    <%= link_to job.title, job_path(job), class: "hover:text-indigo-600" %>
                  </h3>
                  <p class="text-sm text-gray-600">
                    <%= job.company.name %> • <%= job.location %>
                    <% if job.is_remote %>
                      • <span class="text-green-600">Remote</span>
                    <% end %>
                  </p>
                </div>
              </div>

              <p class="mt-3 text-gray-700 line-clamp-3">
                <%= truncate(strip_tags(job.description), length: 180) %>
              </p>

              <div class="mt-4 flex flex-wrap gap-2">
                <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-indigo-100 text-indigo-700">
                  <%= job.employment_type.humanize %>
                </span>
                <% if job.salary_range %>
                  <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-gray-100 text-gray-700">
                    <%= job.salary_range %>
                  </span>
                <% end %>
                <% job.skills.limit(4).each do |skill| %>
                  <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-gray-100 text-gray-700">
                    <%= skill.name %>
                  </span>
                <% end %>
                <% if job.skills.count > 4 %>
                  <span class="text-xs text-gray-500">+<%= job.skills.count - 4 %> more</span>
                <% end %>
              </div>
            </div>

            <!-- Right: Actions -->
            <div class="flex flex-col items-end space-y-3">
              <span class="text-xs text-gray-500">
                Posted <%= time_ago_in_words(job.published_at) %> ago
              </span>

              <div class="flex items-center space-x-2">
                <% if user_signed_in? && current_user.job_seeker? %>
                  <% if current_user.bookmarks.exists?(job: job) %>
                    <%= link_to unbookmark_job_path(job), method: :delete, class: "p-2 text-red-600 hover:text-red-700" do %>
                      ❤️
                    <% end %>
                  <% else %>
                    <%= link_to bookmark_job_path(job), method: :post, class: "p-2 text-gray-400 hover:text-red-600" do %>
                      ♡
                    <% end %>
                  <% end %>
                <% end %>

                <%= link_to "View Details", job_path(job),
                    class: "px-3 py-2 border border-gray-300 text-sm rounded-md bg-white text-gray-700 hover:bg-gray-50 shadow-sm" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <% if @jobs.empty? %>
        <div class="text-center py-12">
          <p class="text-gray-600">No jobs found. Try adjusting your filters.</p>
          <%= link_to "View All Jobs", jobs_path,
              class: "mt-4 inline-block bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-2 rounded-md shadow" %>
        </div>
      <% end %>
    </div>

    <!-- Pagination -->
    <div class="mt-10 flex justify-center">
      <%= paginate @jobs if respond_to?(:paginate) %>
    </div>
  </div>
</div>
