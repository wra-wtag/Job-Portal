<div class="bg-gray-50 min-h-screen">

  <!-- Hero Section -->
  <section class="relative bg-indigo-900 text-white">
    <div class="max-w-6xl mx-auto px-6 py-24 text-center">
      <h1 class="text-5xl sm:text-6xl font-extrabold leading-tight">
        Discover Your Dream Job Today
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-indigo-200">
        Join thousands of professionals finding the perfect job opportunities from top companies.
      </p>
      
      <div class="mt-8 flex flex-col sm:flex-row justify-center gap-4">
        <%= link_to "Search Jobs", jobs_path,
            class: "bg-white text-indigo-900 font-semibold px-6 py-3 rounded-xl shadow-lg hover:bg-indigo-100 transition" %>
        <%= link_to "Sign Up", new_user_registration_path,
            class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-3 rounded-xl shadow-lg transition" %>
      </div>
    </div>
  </section>

  <!-- Featured Jobs Section -->
  <section class="max-w-7xl mx-auto px-6 py-16">
    <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Latest Jobs</h2>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <% @latest_jobs.each do |job| %>
        <div class="bg-white border border-gray-200 rounded-2xl shadow-sm hover:shadow-md transition">
          <div class="p-6 flex flex-col gap-4">
            <h3 class="text-lg font-semibold text-gray-900 hover:text-indigo-600">
              <%= link_to job.title, job_path(job) %>
            </h3>
            <p class="text-sm text-gray-600">
              <%= job.company.name %> • <%= job.location %>
              <% if job.is_remote %>
                • <span class="text-green-600 font-medium">Remote</span>
              <% end %>
            </p>
            <div class="flex flex-wrap gap-2 mt-2">
              <% job.skills.limit(3).each do |skill| %>
                <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-gray-100 text-gray-700">
                  <%= skill.name %>
                </span>
              <% end %>
            </div>
            <%= link_to "View Job", job_path(job),
                class: "mt-4 inline-block bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg shadow" %>
          </div>
        </div>
      <% end %>
    </div>

    <% if @latest_jobs.empty? %>
      <p class="text-center text-gray-600 mt-8">No jobs available at the moment. Check back soon!</p>
    <% end %>
  </section>

  <!-- Companies Section -->
  <section class="bg-gray-100 py-16">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Top Companies Hiring</h2>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 items-center justify-items-center">
        <% @featured_companies.each do |company| %>
          <div class="bg-white p-4 rounded-xl shadow-sm flex items-center justify-center h-24 w-24">
            <% if company.logo.attached? %>
              <%= image_tag company.logo.variant(resize_to_limit: [80, 80]), class: "object-contain h-full w-full" %>
            <% else %>
              <span class="text-gray-600 font-bold"><%= company.name.first.upcase %></span>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- Call to Action Section -->
  <section class="max-w-6xl mx-auto px-6 py-16 text-center">
    <h2 class="text-3xl font-bold text-gray-900">Ready to Start Your Career?</h2>
    <p class="mt-4 text-gray-700">Sign up today and start applying to your dream jobs.</p>
    <%= link_to "Create Account", new_user_registration_path,
        class: "mt-6 inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-3 rounded-xl shadow-lg transition" %>
  </section>
</div>
