<section class="relative bg-gradient-to-br from-indigo-800 to-blue-700 text-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-24 sm:py-32">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="text-center md:text-left">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight">
          Discover Your <span class="text-sky-300">Dream Job</span> Today
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-indigo-200 max-w-xl mx-auto md:mx-0">
          Join thousands of professionals finding the perfect job opportunities from top tech companies.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row justify-center md:justify-start gap-4">
          <%= link_to "Search Jobs", jobs_path,
              class: "bg-white text-indigo-700 font-semibold px-8 py-3 rounded-lg shadow-xl hover:bg-gray-100 transform transition hover:scale-105" %>
          <%= link_to "Sign Up", new_user_registration_path,
              class: "bg-sky-500 hover:bg-sky-600 text-white font-semibold px-8 py-3 rounded-lg shadow-xl transform transition hover:scale-105" %>
        </div>
      </div>
      <div class="hidden md:block">
        <svg class="w-full h-auto" viewBox="0 0 550 450" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="50" y="50" width="450" height="350" rx="20" fill="rgba(255,255,255,0.1)"/>
            <path d="M100 120 H 250" stroke="rgba(255,255,255,0.5)" stroke-width="10" stroke-linecap="round"/>
            <path d="M100 150 H 350" stroke="rgba(255,255,255,0.5)" stroke-width="10" stroke-linecap="round"/>
            <rect x="90" y="200" width="120" height="120" rx="10" fill="rgba(129, 140, 248, 0.6)"/>
            <circle cx="350" cy="260" r="70" fill="rgba(56, 189, 248, 0.6)"/>
            <line x1="150" y1="350" x2="400" y2="100" stroke="rgba(255,255,255,0.2)" stroke-width="4"/>
        </svg>
      </div>
    </div>
  </div>
</section>

<section class="bg-slate-50 py-20 sm:py-24">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Latest Tech Jobs</h2>
      <p class="mt-4 text-lg text-gray-600">Here are some of the most recent opportunities posted on our platform.</p>
    </div>

    <div class="mt-16 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      <% @latest_jobs.each do |job| %>
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex flex-col">
          <div class="p-6 flex-grow">
            <p class="text-sm text-gray-500 mb-2">
              <%= job.company.name %> • <%= job.location %>
              <% if job.is_remote %>
                • <span class="text-green-600 font-semibold">Remote</span>
              <% end %>
            </p>
            <h3 class="text-lg font-semibold text-gray-900 group-hover:text-indigo-600">
              <%= link_to job.title, job_path(job), class: "hover:text-indigo-600 transition stretched-link" %>
            </h3>
            <div class="flex flex-wrap gap-2 mt-4">
              <% job.skills.limit(3).each do |skill| %>
                <span class="px-3 py-1 text-xs font-medium rounded-full bg-indigo-50 text-indigo-800">
                  <%= skill.name %>
                </span>
              <% end %>
            </div>
          </div>
          <div class="bg-gray-50 px-6 py-4 rounded-b-xl mt-auto">
             <%= link_to "View Job", job_path(job),
                 class: "text-indigo-600 hover:text-indigo-800 font-semibold text-sm transition" %>
          </div>
        </div>
      <% end %>

      <% if @latest_jobs.empty? %>
        <p class="text-center text-gray-500 mt-8 col-span-full">No jobs available at the moment. Check back soon!</p>
      <% end %>
    </div>
    
    <% if @latest_jobs.any? %>
      <div class="mt-16 text-center">
        <%= link_to "View All Jobs", jobs_path, class: "inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-8 py-3 rounded-lg shadow-md transition transform hover:scale-105" %>
      </div>
    <% end %>
  </div>
</section>

<section class="bg-white py-20 sm:py-24">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">
    <div class="bg-gradient-to-r from-indigo-700 to-purple-700 text-white rounded-2xl shadow-xl p-12 text-center">
      <h2 class="text-3xl font-bold tracking-tight mb-4">Ready to Start Your Tech Career?</h2>
      <p class="text-indigo-200 mb-8 max-w-2xl mx-auto">Sign up today and start applying to your dream jobs from top software companies around the world.</p>
      <%= link_to "Create Your Account", new_user_registration_path,
          class: "inline-block bg-white text-indigo-700 font-semibold px-8 py-3 rounded-lg shadow-lg transition transform hover:scale-105 hover:bg-gray-100" %>
    </div>
  </div>
</section>